---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import Narration from "../../components/Narration.astro";
import TodayScheduleImage from "../../components/TodayScheduleImage.astro";
import "../../styles/style.css";
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <!-- Ptengine -->
  <script src="https://js.ptengine.jp/55iy7etj.js"></script>
  <script src="https://js.ptengine.jp/554zwt96.js"></script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>instagram</title>
  <meta name="description" content="沖縄・北谷の砂辺クリニック。内科・皮膚科・漢方の予約診療に対応し、健康・レシピ情報も掲載。スマホでも見やすく、使いやすい公式サイト。">
  <link rel="stylesheet" href="style-main.css">

  <style>
    :root{
      --brand:#0b4e9e;       /* 見出しなどの基調色 */
      --accent:#1389ff;      /* 強調やリンク */
      --ink:#1a1a1a;         /* 本文色 */
      --muted:#6b7280;       /* 補助テキスト */
      --bg:#ffffff;          /* 背景 */
      --card:#ffffff;        /* カード背景 */
      --ring:rgba(19,137,255,.25);
      --radius:14px;
      --shadow:0 6px 20px rgba(0,0,0,.08);
    }

    /* ベース */
    body{ color:var(--ink); background:var(--bg); line-height:1.75; }
    .container{
      width:min(100%, 1000px);
      margin-inline:auto;
      padding: clamp(16px, 2vw, 24px);
    }

    /* ヒーロー */
    .hero{
      position:relative;
      padding: clamp(20px, 5vw, 40px) 0;
    }
    .hero-title{
      font-size: clamp(22px, 3.2vw, 32px);
      font-weight: 800;
      color: var(--brand);
      letter-spacing:.02em;
      line-height:1.25;
      margin: 0 0 .25em;
    }
    .hero-lead{
      font-size: clamp(15px, 2.3vw, 18px);
      color: var(--muted);
      margin: 0;
    }

    /* お知らせボックス */
    .notice{
      margin-top: clamp(18px, 2.4vw, 28px);
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      border: 1px solid rgba(17,24,39,.06);
      padding: clamp(14px, 2.2vw, 20px);
    }
    .notice h2{
      display:flex; align-items:center; gap:.5em;
      margin:0 0 .4em;
      font-size: clamp(18px, 2.4vw, 20px);
      color: var(--brand);
      font-weight: 700;
      letter-spacing:.01em;
    }
    .notice p{
      margin:.5em 0 0;
    }
    .notice .small{
      font-size: .92em;
      color: var(--muted);
    }

    /* アクション（ボタン群） */
    .actions{
      margin: clamp(18px, 3vw, 28px) 0;
    }
    .sns-buttons{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(10px, 2.4vw, 16px);
    }
    .sns-buttons a{
      display:block;
      border-radius: 12px;
      overflow:hidden;
      box-shadow: var(--shadow);
      border: 1px solid rgba(17,24,39,.06);
      background:#fff;
      transition: transform .1s ease, box-shadow .2s ease;
      outline: none;
    }
    .sns-buttons a:focus-visible{
      box-shadow: 0 0 0 4px var(--ring);
    }
    .sns-buttons a:hover{ transform: translateY(-2px); }
    .sns-buttons img{
      width:100%;
      height:auto;
      display:block;
      aspect-ratio: 16/10;       /* だいたいの比率で整形 */
      object-fit: cover;
    }

    /* Instagramリンク（固定ボタン） */
    .fixed-button{
      position: fixed;
      right: clamp(14px, 3vw, 22px);
      bottom: clamp(16px, 3.2vw, 24px);
      padding: .85em 1.1em;
      border-radius: 999px;
      background: var(--brand);
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
      letter-spacing:.02em;
      box-shadow: 0 10px 24px rgba(11,78,158,.25);
      border: 1px solid rgba(255,255,255,.2);
      transition: transform .12s ease, box-shadow .2s ease, background .2s;
      z-index: 50;
    }
    .fixed-button:hover{ transform: translateY(-1px); background: var(--accent); }
    .fixed-button:focus-visible{ box-shadow: 0 0 0 4px var(--ring); outline:none; }

    /* セクション余白 */
    section + section{ margin-top: clamp(22px, 4vw, 36px); }

    /* 画像の共通固定サイズ（必要な場合のみ適用） */
    .fixed-size{ width:100%; height:auto; display:block; }

    /* スマホ最適化 */
    @media (max-width: 640px){
      .sns-buttons{ grid-template-columns: 1fr; }
      .fixed-button{ bottom: 14px; right: 14px; }
    }
  </style>
</head>

<body>
  <Header />

  <main class="container">
    <!-- ヒーロー -->
    <section class="hero" aria-labelledby="page-title">
      <h1 id="page-title" class="hero-title">instagramアカウントのご紹介</h1>

    </section>

    <!-- Instagram紹介（文章の構造と文法を調整） -->
    <section class="notice" aria-labelledby="notice-title">
      <h2 id="notice-title">心地よい空間づくりの取り組み</h2>
      <p>
        当クリニックは<strong>ストレスのない健康増進</strong>を目指しています。<br />
        このたび、<strong>プレス沖縄様（代表：林）</strong>と共同で院内の心地よい空間づくりに取り組みました。<br />
        その様子はプレス沖縄のInstagramでご紹介いただいております。
      </p>
      <p class="small">※いいねやフォローはご無理なさらず、まずはお気軽にご覧ください。</p>
      <p>本日も、あなた様にとって素敵な一日でありますように。</p>
    </section>


    <section aria-label="本日の診療案内">
      <TodayScheduleImage />
    </section>
  </main>

  <a href="https://www.instagram.com/pressokinawa/" target="_blank" rel="noopener noreferrer" class="fixed-button" aria-label="プレス沖縄のInstagramを新しいタブで開く">公式Instagram</a>

  <Footer />
</body>
</html>
